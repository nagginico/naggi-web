---
import '../styles/global.css';
import 'lenis/dist/lenis.css';

const {
  title = 'Naggi.cm',
  description = 'Contenido audiovisual y storytelling para marcas de Paraná y Entre Ríos.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
  href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@1..144,1..1000&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
  rel="stylesheet"/>  
  </head>
  <body>
    <slot />
    <script>
  import '../scripts/lenis.js';
</script>
  </body>
</html>